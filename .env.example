# Global Address Platform — Environment Template
# Copy to .env and fill in values. Never commit .env.

# Application
ENVIRONMENT=development
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:3000

# Backend
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
API_V1_PREFIX=/api/v1

# Database (PostgreSQL + PostGIS)
POSTGRES_USER=gap
POSTGRES_PASSWORD=gap_dev_password_change_me
POSTGRES_DB=global_address
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://gap:gap_dev_password_change_me@postgres:5432/global_address

# Redis
REDIS_URL=redis://redis:6379/0

# Rate limiting
RATE_LIMIT_ANONYMOUS=30/minute
RATE_LIMIT_AUTHENTICATED=120/minute
RATE_LIMIT_API_KEY=300/minute

# Geocoding (server-side only — never expose to browser)
GEOCODING_PROVIDER=nominatim
GEOCODING_API_KEY=
GEOCODING_USER_AGENT=GlobalAddressPlatform/0.1.0 (dev; contact@example.com)
GEOCODING_CACHE_TTL_SECONDS=86400
GENERATION_MAX_RETRIES=5

# Supabase (optional — portable; leave empty for local Docker)
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Frontend (public)
NEXT_PUBLIC_API_URL=http://localhost:8000

# Security
API_KEY_HEADER=X-API-Key
SECRET_KEY=change-me-in-production-use-openssl-rand-hex-32
